{
  "name": "pipeline",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/frontend",
    "packages/mcp",
    "packages/trustee",
    "packages/ui",
    "packages/wallet-connect"
  ],
  "scripts": {
    "lint:docs": "npx tsx scripts/lint-docs.ts",
    "lint:comments": "npx tsx scripts/lint-comments.ts",
    "test:e2e-scripts": "npx tsx --test scripts/e2e/e2e.test.ts scripts/e2e/stack.test.ts",
    "codegen": "echo 'TODO: codegen'",
    "prepare": "husky",
    "front:dev": "yarn workspace @pipeline/frontend dev",
    "trustee:dev": "yarn workspace @pipeline/trustee dev"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "packageManager": "yarn@4.13.0"
}

{
  "name": "@pipeline/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "lines": "bash scripts/check-lines.sh",
    "guard": "tsx scripts/tool.ts guard",
    "specs": "tsx --test test/specs.test.ts",
    "tests:allow": "tsx scripts/tool.ts allow",
    "spec:approve": "tsx scripts/tool.ts approve",
    "spec:ratchet": "tsx scripts/tool.ts ratchet",
    "spec:ratchet-flex": "tsx scripts/tool.ts ratchet-flex"
  },
  "dependencies": {
    "effect": "^4.1.2",
    "pg": "^8",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22",
    "@types/pg": "^8.23.1",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.0"
  }
}

# Cross-origin links to the OTHER deployments; unset = static label, no menu.
# Format: "<network>=<url>,...". Both apps share this root .env, so override the
# trustee dev server from the process env: VITE_NETWORK_LINKS="..." yarn dev
# VITE_NETWORK_LINKS=mainnet=https://app.pipeline.one,testnet=https://pipeline.stage.eqlab.net

# ─── KYB document storage (Issue #1267) ──────────────────────────────────────
#
# All five required — the API refuses to boot without them. Keep the bucket private.

SPACES_ACCESS_KEY_ID=                                                    # required
SPACES_SECRET_ACCESS_KEY=                                                # required
SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com                      # required — regional, no bucket in the host
SPACES_REGION=fra1                                                       # required — must match the endpoint
SPACES_BUCKET=                                                           # required

KYB_MAX_DOCUMENT_BYTES=10485760                                          # default 10MB per file
KYB_MAX_FILES_PER_REQUEST=10                                             # default 10; also sets that route's body limit
KYB_MAX_DOCUMENTS_PER_LP=20                                              # default 20, across all requests

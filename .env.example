# ── Shared (API + Worker) ────────────────────────────────────

POSTGRES_URL=postgres://user:password@localhost:5432/pipeline   # required; DATABASE_URL also accepted
BITGO_BASE_URL=https://app.bitgo-test.com    # required
BITGO_ACCESS_TOKEN=                          # required
BITGO_WALLET_ID=                             # required
BITGO_NATIVE_SYMBOL=hteth                    # default hteth; "eth" on mainnet
CRYSTAL_ENABLED=true                         # default true; false skips EVM KYT

# ── Sumsub KYC (API + Worker) ───────────────────────────────

SUMSUB_APP_TOKEN=                       # required
SUMSUB_SECRET_KEY=                      # required
SUMSUB_BASE_URL=https://api.sumsub.com  # required
SUMSUB_VERIFICATION_LEVEL=              # required, e.g. "id-and-liveness"
SUMSUB_WEBHOOK_SECRET_KEY=              # required, webhook HMAC
SUMSUB_SANDBOX=false                    # default false
SUMSUB_TOKEN_TTL_SECS=600               # default 600

# ── API ─────────────────────────────────────────────────────

API_PORT=8080                           # default 8080
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/  # default shown; resolves ipfs:// metadata_uri

# ES256 PEM, newlines as literal \n. Both set or both unset (unset = auth endpoints off).
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# JWT_ES256_PRIVATE_KEY_PEM=            # PKCS#8
# JWT_ES256_PUBLIC_KEY_PEM=             # SPKI

# TURNSTILE_SECRET_KEY=                 # bot defense on signup; UNSET MEANS SIGNUP IS UNPROTECTED

SENDGRID_API_KEY=                       # required unless EMAIL_DEV_LOG=true; Mail Send scope only
SENDGRID_FROM=no-reply@pipeline.one     # required unless EMAIL_DEV_LOG=true; verified sender
# SENDGRID_BASE_URL=https://api.sendgrid.com  # default shown
# EMAIL_DEV_LOG=true                    # local only — logs the passcode instead of sending

CHAINS=1                                # required, comma-separated chain IDs
DEFAULT_CHAIN_ID=1                      # required, must be a member of CHAINS

# Per-chain API voucher signing:
# CHAIN_<id>_SIGNER_KEY=0x...           # optional — EIP-712 voucher signing key
# CHAIN_<id>_DM_ADDRESS=0x...           # required when SIGNER_KEY is set
# CHAIN_<id>_WQ_ADDRESS=0x...           # required when SIGNER_KEY is set
# CHAIN_1_SIGNER_KEY=0x...
# CHAIN_1_DM_ADDRESS=0x...
# CHAIN_1_WQ_ADDRESS=0x...

# ── Worker: Job-level (un-sharded) ──────────────────────────

JOB_INDEXER_ENABLED=false
JOB_PRICE_POLLER_ENABLED=false
JOB_KYC_ENABLED=false
JOB_RELAYER_ENABLED=false
JOB_ASSET_PRICE_COLLECTOR_ENABLED=false

# All-chain fallback; any chain overrides via CHAIN_<id>_<EVM|STELLAR>_INDEXER_<same name>.
JOB_INDEXER_POLLING_BLOCK_RANGE=1000               # default 1000, >= 1
JOB_INDEXER_POLLING_INTERVAL_MS=500                # default 500, >= 1; EVM sleeps it twice per cycle (~2x)
JOB_INDEXER_LOG_CONFIRMATIONS_DELAY=12             # default 12; EVM only
JOB_INDEXER_IPFS_GATEWAY_URL=https://ipfs.io/ipfs/ # default shown; fetches LoanDrawn metadata

# Stellar asset-transfer tracking (all Stellar chains). ASSET_ID alone enables it;
# CUSTODY+RAMP are an optional pair that adds internal-movement tracking — set both or neither.
JOB_INDEXER_STELLAR_ASSET_ID=CCWX3TKH3K5SQDPOBGQTGOGE6Q5VEZWCOYJ2HDVV5U6GNN5U4WOEB3C7   # SAC id of the watched asset
# JOB_INDEXER_STELLAR_CUSTODY_ADDRESSES=G...,C...   # custody G… / C… addresses
# JOB_INDEXER_STELLAR_RAMP_ADDRESSES=G...,C...      # ramp G… / C… addresses

JOB_PRICE_POLLER_START_BLOCK=0                     # first block to collect from
JOB_PRICE_POLLER_BLOCK_INTERVAL=300                # default 300 — snapshot every N blocks
JOB_PRICE_POLLER_POLL_INTERVAL_SECS=10             # default 60 — seconds between polls
JOB_PRICE_POLLER_RPC_DELAY_MS=5000                 # default 200 — backfill inter-call sleep

JOB_RELAYER_INTERVAL_SECS=60                       # default 60
JOB_RELAYER_SUMSUB_ENABLED=true                    # default true
JOB_RELAYER_YIELD_MINTER_BATCH_SIZE=50             # default 50 — rows per cycle

JOB_KYC_INTERVAL_SECS=30                           # default 30
JOB_KYC_BATCH_SIZE=100                             # default 100

JOB_ASSET_PRICE_COLLECTOR_INTERVAL=DAYS            # required — HOURS or DAYS
JOB_ASSET_PRICE_COLLECTOR_RETENTION=90             # required — grid points kept per asset, >= 1

PRICE_PROVIDER_ALLOW_NON_MARKET=true               # dev/test only — allows the static price stub

METALPRICE_API_KEY=                                   # required when a loan uses price_provider=metal_price
METALPRICE_BASE_URL=https://api.metalpriceapi.com/v1  # default shown

# ── Worker: Per-chain config ─────────────────────────────────
#
# Naming (#1456): CHAIN_<id>_<EVM|STELLAR>_<KEY> for a fact every job shares,
# CHAIN_<id>_<EVM|STELLAR>_<COMPONENT>_<KEY> for one component's. A key of the
# other kind aborts startup, so the prefixes can never drift from CHAIN_<id>_TYPE.
#
# EVM example (CHAINS=1):
#
# CHAIN_1_EVM_RPC_URL=https://mainnet.infura.io/v3/<key>  # required — indexer, price-poller, relayer
# CHAIN_1_EVM_START_BLOCK=0                               # default 0 — seed cursor; use the deploy block on mainnet
# CHAIN_1_EVM_INDEXER_DEPOSIT_MANAGER_ADDRESS=0xabc...    # required
# CHAIN_1_EVM_INDEXER_WITHDRAWAL_QUEUE_ADDRESS=0xabc...   # required
# CHAIN_1_EVM_INDEXER_STAKED_PLUSD_ADDRESS=0xabc...       # required — sPLUSD vault
# CHAIN_1_EVM_INDEXER_LOAN_REGISTRY_ADDRESS=0xabc...      # required
# CHAIN_1_EVM_INDEXER_MINTER_ADDRESS=0xabc...             # required — PipelineMinter
#
# CHAIN_1_EVM_INDEXER_POLLING_BLOCK_RANGE=1000            # default 1000 — one eth_getLogs span
# CHAIN_1_EVM_INDEXER_POLLING_INTERVAL_MS=500             # default 500; slept twice per cycle (~2x)
# CHAIN_1_EVM_INDEXER_LOG_CONFIRMATIONS_DELAY=12          # default 12 — blocks held back; no STELLAR spelling exists
#
# CHAIN_1_RELAYER_SIGNER_KEY=0x...                        # required — whitelist tx key
# CHAIN_1_RELAYER_REGISTRY_ADDRESS=0x...                  # required — WhitelistRegistry
# CHAIN_1_RELAYER_YIELD_MINTER_ADDRESS=0x...              # required — PipelineYieldMinter
# CHAIN_1_RELAYER_LOAN_REGISTRY_ADDRESS=0x...             # required — LoanRegistry

# ── Stellar chain example (Worker: Indexer) ──────────────────
#
# Add alongside the EVM chain: CHAINS=1,99000001. The 99M+ range is the non-EVM
# sentinel (99000001=testnet, 99000002=mainnet).
#
# CHAIN_99000001_TYPE=stellar
# CHAIN_99000001_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# CHAIN_99000001_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015   # omit for the testnet sentinel
# CHAIN_99000001_STELLAR_INDEXER_DEPOSIT_MANAGER_ADDRESS=CARFA2QETOZVKHSG4BCEEXMJHTYR2Z75VR7WQNX4MWZ33RQMKRKATIVI
# CHAIN_99000001_STELLAR_INDEXER_WITHDRAWAL_QUEUE_ADDRESS=CC3TWGFXP2XUZJXGLVTM2G4K2PF2YTC6BKDRPZIUPSVETNYAO57GU3Q7
# CHAIN_99000001_STELLAR_INDEXER_WITHDRAWAL_QUEUE_WALLET_ADDRESS=GDH66JAF6T5MD45GUGR7T7ITDRDX3Z5OMISPQZKK6LHJ3CW3VPC53KIU   # optional — MPC custody G-account, not the queue contract
# CHAIN_99000001_STELLAR_INDEXER_STAKED_PLUSD_ADDRESS=CDO4X3HCPR44UGXJ5PE35JBB4SYVDRQETXXOPQZLB7THN6FOTBTRKLW5
# CHAIN_99000001_STELLAR_INDEXER_LOAN_REGISTRY_ADDRESS=   # optional — set once deployed
# CHAIN_99000001_STELLAR_INDEXER_MINTER_ADDRESS=          # optional — indexes WireIn/WireInAssigned; also gates the relayer's wire-in matching, which reads THIS key
# CHAIN_99000001_STELLAR_ACCESS_MANAGER_ID=CBJUO44GFUU3NTDTTNJTLLIIC6RGNAS6NLPNIJYYZKFY5NSZ3IMMZ4Q5   # documentation only
# CHAIN_99000001_STELLAR_USDC_ASSET_ID=CCWX3TKH3K5SQDPOBGQTGOGE6Q5VEZWCOYJ2HDVV5U6GNN5U4WOEB3C7       # documentation only
# CHAIN_99000001_STELLAR_PLUSD_ASSET_ID=CAC7JMGRFZBL4IS4WBO5R3AMTK3C53FEOQZSU2WL5C4TWCRFAYWFSIBN      # documentation only
# CHAIN_99000001_STELLAR_INDEXER_POLLING_INTERVAL_MS=500   # default 500
# CHAIN_99000001_STELLAR_INDEXER_POLLING_BLOCK_RANGE=1000  # default 1000 — sizes a ledger range under the BLOCK_RANGE name
# CHAIN_99000001_STELLAR_START_BLOCK=0                     # keep within ~7 days — Soroban RPC retains no more
#
# Price-poller (Stellar) — samples convert_to_assets at the current ledger; vault
# address comes from the `vaults` table. RPC/passphrase fall back to the chain-wide
# CHAIN_<id>_STELLAR_* vars. JOB_PRICE_POLLER_* are EVM-only and ignored here.
# CHAIN_99000001_PRICE_POLLER_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# CHAIN_99000001_PRICE_POLLER_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# CHAIN_99000001_PRICE_POLLER_STELLAR_INTERVAL_SECS=10     # default 60

# ── Stellar chain example (Relayer: whitelist sync via access_manager) ──────────
#
# Phase 0 (lp_profiles seeding) + Phase 3 (on-chain whitelist). Sumsub is gated by
# JOB_RELAYER_SUMSUB_ENABLED, KYT by ELLIPTIC_ENABLED (Stellar uses Elliptic, EVM Crystal).
#
# CHAIN_99000001_RELAYER_STELLAR_ACCESS_MANAGER_ID=CBJUO44GFUU3NTDTTNJTLLIIC6RGNAS6NLPNIJYYZKFY5NSZ3IMMZ4Q5   # execute() target
# CHAIN_99000001_RELAYER_STELLAR_PLUSD_SAC_ID=CAC7JMGRFZBL4IS4WBO5R3AMTK3C53FEOQZSU2WL5C4TWCRFAYWFSIBN        # inner timelock target
# CHAIN_99000001_RELAYER_STELLAR_SIGNER_SECRET=S...        # its G… must hold `executor` on the access-manager
# CHAIN_99000001_RELAYER_STELLAR_RPC_URL=https://soroban-testnet.stellar.org                 # optional — falls back to the chain-wide var
# CHAIN_99000001_RELAYER_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015        # optional — falls back to the chain-wide var
# JOB_RELAYER_STELLAR_BATCH_SIZE=50                        # default 50 — rows per cycle

# ── Stellar chain example (Relayer: Phase 4 yield-mint) ──────────
#
# Optional; enabled only when BOTH ids are set, otherwise silently skipped. A
# malformed value fails at startup. Requires out-of-band role grants: the signer's
# G… needs `minter`, the yield-minter needs `executor`.
#
# CHAIN_99000001_RELAYER_STELLAR_YIELD_MINTER_ID=C...      # mint_yield target
# CHAIN_99000001_RELAYER_STELLAR_LOAN_REGISTRY_ID=C...     # PaymentRecorded filter + can_yield_be_minted

# ── Stellar chain example (API: Voucher signing) ──────────────
#
# Parallel to (not aliases of) the indexer's vars — the API and indexer may target
# different deployments by design (exec plan #555 §Resolved §1).
#
# STELLAR_VERIFIER_SECRET=S...          # chain-agnostic ed25519 seed; testnet pubkey GDH66JAF6T5MD45GUGR7T7ITDRDX3Z5OMISPQZKK6LHJ3CW3VPC53KIU
# CHAIN_99000001_API_STELLAR_DM_CONTRACT_ID=CARFA2QETOZVKHSG4BCEEXMJHTYR2Z75VR7WQNX4MWZ33RQMKRKATIVI
# CHAIN_99000001_API_STELLAR_WQ_CONTRACT_ID=CC3TWGFXP2XUZJXGLVTM2G4K2PF2YTC6BKDRPZIUPSVETNYAO57GU3Q7
# CHAIN_99000001_API_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015   # omit for the testnet sentinel

# ── Stellar chain example (API: Capital allocation in_transit / withdrawal_queue) ──
#
# in_transit = Σ(custody→ramp) − Σ(ramp→custody), clamped at 0; served as null
# unless BOTH address sets are present.
#
# CHAIN_99000001_API_STELLAR_CUSTODY_ADDRESSES=G...,C...
# CHAIN_99000001_API_STELLAR_RAMP_ADDRESSES=G...,C...
# CHAIN_99000001_API_STELLAR_WITHDRAWAL_QUEUE_WALLET_ID=G...   # optional — `withdrawal_queue` bucket
# CHAIN_99000001_API_STELLAR_ASSET_DECIMALS=7                  # default 7 (USDC SAC), <= 18

# ── Crystal Intelligence KYT (Worker: Relayer) ───────────────

CRYSTAL_API_KEY=                                          # required when CRYSTAL_ENABLED=true
CRYSTAL_BASE_URL=https://apiexpert.crystalblockchain.com  # default shown
CRYSTAL_BLOCKCHAIN=eth                                    # optional; required for transaction checks
CRYSTAL_TOKEN_ID=138052                                   # default 0 (base asset)
CRYSTAL_RISK_SCORE_THRESHOLD=0.7                          # default 0.7 (0.0–1.0)
CRYSTAL_HARD_FAIL_SIGNALS="child_exploitation,dark_market,dark_service,enforcement_action,exchange_fraudulent,gambling,illegal_service,mixer,ransom,sanctions,scam,stolen_coins,terrorism_financing"   # default: all 24 signals

# ── Elliptic KYT (Worker: Stellar Relayer + API: Stellar vouchers) ───────────

ELLIPTIC_ENABLED=false                             # default false
ELLIPTIC_API_KEY=                                  # required when enabled — x-access-key
ELLIPTIC_API_SECRET=                               # required when enabled — base64 HMAC key
ELLIPTIC_BASE_URL=https://aml-api.elliptic.co      # default shown
ELLIPTIC_ASSET=holistic                            # default holistic (auto-detect)
ELLIPTIC_BLOCKCHAIN=holistic                       # default holistic (auto-detect)
ELLIPTIC_RISK_THRESHOLD=0.5                        # default 0.5 (0.0–1.0)

